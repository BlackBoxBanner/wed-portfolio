    "@react-pdf/renderer": "^4.3.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/mdx": "^2.0.13",
    "@types/nodemailer": "^6.4.15",
    "class-variance-authority": "^0.7.0",
