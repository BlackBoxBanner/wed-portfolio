    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "prettier": "3.9.6",
    "react-icons": "^5.7.0",
    "tailwindcss": "^4.3.3",
